general {
    hide_cursor = true
    grace = 0
}

auth {
    pam:enabled = true
}

background {
    path = screenshot
    blur_passes = 3
    blur_size = 2
    noise = 0.006
}

label {
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = rgba(205, 214, 244, 0.95)
    font_size = 120
    font_family = JetBrains Mono Bold
    position = 0, 180
    halign = center
    valign = center
}

label {
    text = - PAIN IS REAL, BUT SO IS HOPE -
    color = rgba(203, 166, 247, 0.7)
    font_size = 16
    font_family = JetBrains Mono
    position = 0, 100
    halign = center
    valign = center
}

label {
    text = Welcome back $USER
    color = rgba(166, 227, 161, 0.9)
    font_size = 28
    font_family = JetBrains Mono
    position = 0, 40
    halign = center
    valign = center
}

input-field {
    size = 300, 60
    outline_thickness = 2
    dots_size = 0.3
    dots_spacing = 0.5
    dots_center = true
    inner_color = rgba(30, 30, 50, 0.6)
    outer_color = rgba(137, 180, 250, 0.8)
    font_color = rgba(205, 214, 244, 1.0)
    fade_on_empty = false
    placeholder_text = unlock the magic...
    fail_color = rgba(243, 139, 168, 1.0)
    hide_input = false
    position = 0, -120
    halign = center
    valign = center
}