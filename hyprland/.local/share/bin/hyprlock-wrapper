#!/bin/bash
# hyprlock launcher with double-launch guard + random fail message injection

LOCKFILE="/tmp/hyprlock.lock"
if [ -f "$LOCKFILE" ] && kill -0 "$(cat "$LOCKFILE" 2>/dev/null)" 2>/dev/null; then
    exit 0
fi

# pick a random fail message, pango-escape it
FAIL_MSG=$(shuf -n1 ~/.config/hypr/hyprlock-fails.txt 2>/dev/null || echo "Wrong password")
ESCAPED_FAIL=$(echo "$FAIL_MSG" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')

# inject into a per-run temp config (main config stays immutable)
TMP_CONF=$(mktemp /tmp/hyprlock-config.XXXXXX)
trap 'rm -f "$TMP_CONF" "$LOCKFILE"' EXIT
cp ~/.config/hypr/hyprlock.conf "$TMP_CONF"
sed -i "s|fail_text = Access denied. Skill issue detected.|fail_text = $ESCAPED_FAIL|" "$TMP_CONF"

hyprlock -c "$TMP_CONF" &
LOCK_PID=$!
echo "$LOCK_PID" > "$LOCKFILE"
wait "$LOCK_PID" 2>/dev/null
