#!/bin/bash
# hyprlock-wrapper: injects fail message and now playing, launches hyprlock

FAIL_MSG=$(shuf -n1 ~/.config/hypr/hyprlock-fails.txt)
NOW_PLAYING=$(playerctl metadata --format "{{ artist }} - {{ title }}" 2>/dev/null || echo "not playing")

# Escape for pango
ESCAPED_FAIL=$(echo "$FAIL_MSG" | sed "s/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g")
ESCAPED_PLAYING=$(echo "$NOW_PLAYING" | sed "s/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g")

# Copy main config and inject dynamic values
cp ~/.config/hypr/hyprlock.conf /tmp/hyprlock-config.tmp

# Replace now playing placeholder
sed -i "s|not playing|$ESCAPED_PLAYING|g" /tmp/hyprlock-config.tmp

# Append fail message to input-field
sed -i "s/fail_text = Access denied. Skill issue detected./fail_text = $ESCAPED_FAIL/" /tmp/hyprlock-config.tmp

# Launch hyprlock with temp config
hyprlock -c /tmp/hyprlock-config.tmp

# Cleanup
rm /tmp/hyprlock-config.tmp
