#!/usr/bin/env python3
"""Archive native transcripts as compressed content objects. Old copies are only replaced when a newer copy contains them byte for byte."""
import datetime
import fcntl
import gzip
import hashlib
import json
import os
import shutil
from pathlib import Path
import tempfile

os.umask(0o077)
archive = Path.home() / '.local/share/t3-session-archive'
archive.mkdir(parents=True, exist_ok=True, mode=0o700)
lock = (archive / 'lock').open('w')
fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
objects = archive / 'objects'
objects.mkdir(exist_ok=True, mode=0o700)
index_path = archive / 'index.json'
index = json.loads(index_path.read_text()) if index_path.exists() else {}
changed = 0
seen = 0
superseded = set()


def save(source, relative, size, modified, stream):
    global changed, seen
    seen += 1
    key = source + '/' + relative
    stamp = {'size': size, 'modified': modified}
    old = index.get(key)
    if old and all(old.get(k) == v for k, v in stamp.items()):
        return
    digest = hashlib.sha256()
    # transcripts are append-only, so an old copy whose bytes are an exact prefix of the
    # new file holds nothing the new copy doesn't. only that case gets replaced
    prefix = hashlib.sha256() if old and old['size'] <= size else None
    prefix_left = old['size'] if prefix else 0
    fd, temporary = tempfile.mkstemp(prefix='.pending-', dir=objects)
    try:
        remaining = size
        with os.fdopen(fd, 'wb') as output, gzip.GzipFile(fileobj=output, mode='wb', compresslevel=3, mtime=0) as compressed:
            while remaining:
                if shutil.disk_usage(archive).free < 2 * 1024**3:
                    raise OSError('Archive paused: less than 2 GiB free; existing records are preserved')
                data = stream.read(min(1024 * 1024, remaining))
                if not data:
                    raise OSError('Source changed or ended during archive read')
                digest.update(data)
                if prefix_left:
                    prefix.update(data[:prefix_left])
                    prefix_left -= min(len(data), prefix_left)
                compressed.write(data)
                remaining -= len(data)
        checksum = digest.hexdigest()
        destination = objects / (checksum + '.gz')
        if destination.exists():
            Path(temporary).unlink()
        else:
            os.rename(temporary, destination)
        record = {'source': source, 'path': relative, **stamp, 'sha256': checksum,
                  'captured_at': datetime.datetime.now(datetime.timezone.utc).isoformat()}
        with (archive / 'captures.jsonl').open('a') as journal:
            journal.write(json.dumps(record) + '\n')
        index[key] = {**stamp, 'sha256': checksum}
        if prefix and prefix.hexdigest() == old['sha256'] != checksum:
            superseded.add(old['sha256'])
        changed += 1
    finally:
        if Path(temporary).exists():
            Path(temporary).unlink()


host_roots = {
    'host-codex': Path.home() / '.codex/sessions',
    'host-codex-archived': Path.home() / '.codex/archived_sessions',
    'host-claude': Path.home() / '.claude/projects',
}
for source, root in host_roots.items():
    if not root.is_dir():
        continue
    for directory, _, names in os.walk(root, followlinks=False):
        for name in names:
            path = Path(directory) / name
            if path.is_symlink() or not path.is_file():
                continue
            try:
                with path.open('rb') as stream:
                    stat = os.fstat(stream.fileno())
                    save(source, str(path.relative_to(root)), stat.st_size, stat.st_mtime_ns, stream)
            except FileNotFoundError:
                continue

temporary_index = index_path.with_suffix('.tmp')
temporary_index.write_text(json.dumps(index, separators=(',', ':')))
os.replace(temporary_index, index_path)
# only drop objects after the index stops pointing at them
superseded -= {entry['sha256'] for entry in index.values()}
for checksum in superseded:
    (objects / (checksum + '.gz')).unlink(missing_ok=True)
print(f'Archived {changed} new or changed files; examined {seen}. '
      f'Replaced {len(superseded)} older copies fully contained in newer ones.', flush=True)
