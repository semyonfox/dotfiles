// wallpaper/theme selector — matches launcher style (style_1.rasi).
// backup at ~/dotfiles/home/.config/rofi/selector.rasi.hyde-bak

configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "{name}";
    font:                        "JetBrainsMono Nerd Font 10";
}

@theme "~/.config/rofi/theme.rasi"

window {
    enabled:                     true;
    fullscreen:                  false;
    transparency:                "real";
    cursor:                      "default";
    location:                    center;
    anchor:                      center;
    width:                       32em;
    padding:                     1em;
    border:                      0px;
    border-radius:               0.8em;
    background-color:            @main-bg;
    children:                    [ "listview" ];
}

listview {
    enabled:                     true;
    spacing:                     0.5em;
    padding:                     0em;
    columns:                     4;
    lines:                       2;
    dynamic:                     true;
    fixed-height:                true;
    fixed-columns:               true;
    scrollbar:                   false;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}

element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     0.35em;
    padding:                     0.5em;
    cursor:                      pointer;
    border-radius:               0.5em;
    background-color:            #00000022;
    text-color:                  @main-fg;
    children:                    [ "element-icon", "element-text" ];
}
element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}
element-icon {
    cursor:                      inherit;
    size:                        5em;
    horizontal-align:            0.5;
    background-color:            transparent;
    text-color:                  inherit;
    expand:                      false;
}
element-text {
    font:                        "JetBrainsMono Nerd Font 9";
    vertical-align:              0.5;
    horizontal-align:            0.5;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
