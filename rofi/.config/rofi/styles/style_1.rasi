// launcher style — compact, no wallpaper panel.
// backup at ~/dotfiles/home/.config/rofi/styles/style_1.rasi.hyde-bak

configuration {
    modi:                        "drun,filebrowser,window,run";
    show-icons:                  true;
    display-drun:                "apps";
    display-run:                 "run";
    display-filebrowser:         "files";
    display-window:              "windows";
    drun-display-format:         "{name}";
    window-format:               "{w}{t}";
    font:                        "JetBrainsMono Nerd Font 10";
    icon-theme:                  "Tela-circle-dracula";
}

@theme "~/.config/rofi/theme.rasi"

window {
    height:                      34em;
    width:                       32em;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border-color:                @main-br;
    background-color:            @main-bg;
}
mainbox {
    enabled:                     true;
    spacing:                     0.7em;
    padding:                     1em;
    orientation:                 vertical;
    children:                    [ "inputbar", "mode-switcher", "listview" ];
    background-color:            transparent;
}

// Search //
inputbar {
    enabled:                     true;
    spacing:                     0.6em;
    padding:                     0.55em 0.9em;
    border-radius:               0.6em;
    background-color:            #00000033;
    text-color:                  @main-fg;
    children:                    [ "prompt", "entry" ];
}
prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
}
entry {
    enabled:                     true;
    expand:                      true;
    placeholder:                 "search…";
    placeholder-color:           #cdd6f477;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      text;
}

// Mode tabs //
mode-switcher {
    orientation:                 horizontal;
    enabled:                     true;
    spacing:                     0.4em;
    background-color:            transparent;
}
button {
    cursor:                      pointer;
    padding:                     0.35em 0.9em;
    border-radius:               0.5em;
    background-color:            #00000022;
    text-color:                  @main-fg;
    horizontal-align:            0.5;
}
button selected {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}

// List //
listview {
    enabled:                     true;
    spacing:                     0.1em;
    padding:                     0em;
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    expand:                      true;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}

element {
    enabled:                     true;
    spacing:                     0.9em;
    padding:                     0.5em 1em;
    cursor:                      pointer;
    border-radius:               0.5em;
    background-color:            transparent;
    text-color:                  @main-fg;
}
element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}
element-icon {
    size:                        2.6em;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

error-message {
    text-color:                  @main-fg;
    background-color:            @main-bg;
    text-transform:              capitalize;
    children:                    [ "textbox" ];
}
textbox {
    text-color:                  inherit;
    background-color:            inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
