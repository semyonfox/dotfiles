#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Keep systemd's environment from resolving a user-controlled executable first.
PATH=/usr/local/bin:/usr/bin:/bin
export PATH

# the nas serves this repo through rest-server in append-only mode, so this
# laptop can add and read snapshots but never delete them. retention and prune
# run on the server against the repo directly
readonly rest_host=10.0.0.6
readonly rest_port=8000
readonly repo="rest:http://$rest_host:$rest_port/semyon-laptop/"
readonly rest_user=semyon-laptop
readonly rest_password_file="$HOME/.config/restic/rest-server.password"
readonly password_file="$HOME/.config/restic/password"
readonly tag=semyon-laptop
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/backup-to-nas"
readonly lock_file="$state_dir/restic.lock"
readonly last_success_file="$state_dir/last-success"
# the timer fires hourly so a laptop that was asleep or away at night still
# backs up once it's back. this gap keeps that to roughly one snapshot a day
readonly min_gap_seconds=$((20 * 60 * 60))
# exit code the unit treats as success: nothing went wrong, just try later
readonly ex_tempfail=75

die() {
  printf 'backup-to-nas: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'Usage: %s [backup|maintenance|preflight]\n' "${0##*/}" >&2
}

acquire_lock() {
  mkdir -p "$state_dir"
  chmod 700 "$state_dir"
  exec 9>"$lock_file"
  flock -w 1800 9 || die 'another laptop Restic job still holds the lock'
}

ensure_existing_repository() {
  [[ -r "$password_file" ]] || die 'missing or unreadable Restic password file'
  [[ -r "$rest_password_file" ]] || die 'missing or unreadable rest-server login file'

  # restic retries an unreachable rest server for minutes, so fail fast instead
  if ! timeout 15s bash -c ': </dev/tcp/$0/$1' "$rest_host" "$rest_port" 2>/dev/null; then
    printf 'backup-to-nas: rest-server at %s:%s unreachable, retrying next hour\n' "$rest_host" "$rest_port" >&2
    exit "$ex_tempfail"
  fi

  export RESTIC_REPOSITORY="$repo"
  export RESTIC_PASSWORD_FILE="$password_file"
  export RESTIC_REST_USERNAME="$rest_user"
  RESTIC_REST_PASSWORD="$(<"$rest_password_file")"
  export RESTIC_REST_PASSWORD

  # Never create a repository from a scheduled job. A mount, password, or NAS
  # failure must fail closed rather than silently producing a new empty repo.
  restic snapshots --no-lock --compact >/dev/null || \
    die 'existing Restic repository is unavailable; refusing to run restic init'

  # a laptop run killed by power loss or a hard shutdown leaves its lock behind,
  # and an exclusive one blocks this job and the server's b2 copy until removed.
  # plain unlock only drops stale locks (dead pid on this host, or not refreshed
  # for 30 min), so live jobs elsewhere keep theirs. append-only still allows it
  restic unlock || printf 'backup-to-nas: stale lock cleanup failed, continuing\n' >&2
}

backed_up_recently() {
  local last now
  [[ -r "$last_success_file" ]] || return 1
  last=$(<"$last_success_file")
  [[ "$last" =~ ^[0-9]+$ ]] || return 1
  now=$(date +%s)
  ((now - last < min_gap_seconds))
}

sources=()
add() {
  if [[ -e "$1" ]]; then
    sources+=("$1")
  fi
  return 0
}

add_prismlauncher_essentials() {
  local prism_root="$HOME/.local/share/PrismLauncher"

  # whole instances: worlds, replays, packs, configs, mod jars and their
  # .index metadata. launcher payloads (libraries, assets, java, meta) live
  # outside instances/ and are re-downloaded, logs and .fabric caches are
  # excluded in run_backup
  add "$prism_root/prismlauncher.cfg"
  add "$prism_root/instances"
}

collect_sources() {
  sources=()

  # Personal data and active work.
  add "$HOME/Documents"
  add "$HOME/Downloads"
  add "$HOME/Desktop"
  add "$HOME/Pictures"
  add "$HOME/Videos"
  add "$HOME/code"
  add "$HOME/obsidian"
  add "$HOME/dotfiles"

  # Existing agent/workflow state retained for continuity after recovery.
  add "$HOME/.t3"
  add "$HOME/.claude"
  add "$HOME/.codex"

  # Device and workflow configuration. Do not include the Restic password.
  add "$HOME/.config/obs-studio/basic"
  add "$HOME/.config/obs-studio/global.ini"
  add "$HOME/.config/obs-studio/user.ini"
  add "$HOME/.config/obs-studio/plugin_config"
  add "$HOME/.config/systemd/user"
  add "$HOME/.config/hypr"
  add "$HOME/.config/zed/settings.json"
  add "$HOME/.config/zed/keymap.json"
  add "$HOME/.config/zed/tasks.json"
  add "$HOME/.config/zed/snippets"
  add "$HOME/.local/bin"

  # User-generated game data, without game installs or launcher payloads.
  add "$HOME/.local/share/Steam/userdata"
  add_prismlauncher_essentials

  ((${#sources[@]})) || die 'no configured backup source paths exist'
}

run_backup() {
  collect_sources

  # exit 3 still writes a snapshot, just missing files that vanished or were
  # unreadable mid-run, so count it as done rather than retrying every hour
  local rc=0
  restic --retry-lock 5m backup --tag "$tag" --skip-if-unchanged --exclude-caches \
    --exclude "$HOME/dotfiles/home/.ssh/**" \
    --exclude "$HOME/.local/bin/uv" \
    --exclude "$HOME/.local/bin/uvx" \
    --exclude "$HOME/.local/share/PrismLauncher/instances/*/minecraft/logs" \
    --exclude "$HOME/.local/share/PrismLauncher/instances/*/minecraft/.fabric" \
    "${sources[@]}" || rc=$?
  ((rc == 0 || rc == 3)) || exit "$rc"

  date +%s >"$last_success_file"
}

run_maintenance() {
  # read-only integrity sample. forget and prune live on the server
  restic --retry-lock 5m check --read-data-subset=5% --with-cache
}

run_preflight() {
  collect_sources
  printf 'backup-to-nas: preflight OK (%d source paths)\n' "${#sources[@]}"
}

mode=${1:-backup}
[[ $# -le 1 ]] || { usage; exit 64; }
case "$mode" in
  backup|maintenance|preflight) ;;
  *) usage; exit 64 ;;
esac

acquire_lock
if [[ "$mode" == backup ]] && backed_up_recently; then
  printf 'backup-to-nas: last backup under 20h ago, skipping\n'
  exit 0
fi
ensure_existing_repository

case "$mode" in
  backup) run_backup ;;
  maintenance) run_maintenance ;;
  preflight) run_preflight ;;
esac
