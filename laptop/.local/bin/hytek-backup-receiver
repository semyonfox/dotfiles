#!/usr/bin/env python3
"""receive Team Manager backups from the HyTek-Windows11 guest.

the guest's user-mode network reaches the host's loopback as 10.0.2.2, so this
listens on 127.0.0.1 only. the guest PUTs /hytek-tm/<name>.zip|.mdb, each file
lands in ~/backups/hytek-tm dated, latest.<ext> points at the newest and only
the 30 newest are kept. the server copies latest.* to the NAS every night
"""
import os
import re
import sys
import tempfile
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

DEST = Path.home() / 'backups' / 'hytek-tm'
PORT = int(os.environ.get('HYTEK_BACKUP_PORT', '8766'))
MAX_BYTES = 500 * 1024 * 1024
KEEP = 30
NAME = re.compile(r'^/hytek-tm/([A-Za-z0-9][A-Za-z0-9._-]{0,120}\.(zip|mdb))$', re.I)


class Handler(BaseHTTPRequestHandler):
    def do_PUT(self):
        match = NAME.match(self.path)
        size = int(self.headers.get('Content-Length') or 0)
        if not match or not 0 < size <= MAX_BYTES:
            return self.send_error(400, 'expected PUT /hytek-tm/<name>.zip|.mdb with a body')
        name, ext = match.group(1), match.group(2).lower()
        DEST.mkdir(parents=True, exist_ok=True, mode=0o700)
        stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
        target = DEST / f'{stamp}-{name}'
        fd, tmp = tempfile.mkstemp(dir=DEST, prefix='.partial-')
        try:
            remaining = size
            with os.fdopen(fd, 'wb') as out:
                while remaining:
                    chunk = self.rfile.read(min(remaining, 1 << 20))
                    if not chunk:
                        raise ConnectionError('upload ended early')
                    out.write(chunk)
                    remaining -= len(chunk)
            os.chmod(tmp, 0o600)
            os.replace(tmp, target)
        except Exception as error:
            Path(tmp).unlink(missing_ok=True)
            return self.send_error(500, str(error))
        latest = DEST / f'latest.{ext}'
        link = DEST / f'.latest-{stamp}.{ext}'
        link.symlink_to(target.name)
        os.replace(link, latest)
        for old in sorted(DEST.glob(f'*-*.{ext}'))[:-KEEP]:
            old.unlink()
        self.send_response(201)
        self.end_headers()
        self.wfile.write(f'saved {target.name} ({size} bytes)\n'.encode())
        print(f'saved {target.name} ({size} bytes)', flush=True)

    def log_message(self, *args):
        pass


if __name__ == '__main__':
    server = ThreadingHTTPServer(('127.0.0.1', PORT), Handler)
    print(f'hytek-backup-receiver on 127.0.0.1:{PORT} -> {DEST}', flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        sys.exit(0)
