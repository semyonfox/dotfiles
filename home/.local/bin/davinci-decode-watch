#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/davinci-decode-fix/config"
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Config not found: $CONFIG_FILE"
    exit 1
fi

# shellcheck source=/dev/null
source "$CONFIG_FILE"

LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/davinci-decode-fix"
LOG_FILE="${LOG_FILE:-$LOG_DIR/watch.log}"
mkdir -p "$LOG_DIR"

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG_FILE"
}

if ! command -v inotifywait >/dev/null 2>&1; then
    log "ERROR: inotifywait not found. Install inotify-tools."
    exit 1
fi

if [[ -z "${WATCH_DIRS:-}" ]]; then
    log "ERROR: WATCH_DIRS is empty in $CONFIG_FILE"
    exit 1
fi

read -ra raw_dirs <<< "$WATCH_DIRS"
valid_dirs=()
for dir in "${raw_dirs[@]}"; do
    expanded="${dir/#\~/$HOME}"
    if [[ -d "$expanded" ]]; then
        valid_dirs+=("$expanded")
        log "Watching: $expanded"
    else
        log "Skip missing watch dir: $expanded"
    fi
done

if [[ ${#valid_dirs[@]} -eq 0 ]]; then
    log "ERROR: no valid watch directories"
    exit 1
fi

log "DaVinci decode watcher started"
"$HOME/.local/bin/davinci-decode-fix" --prune || true

inotifywait -m -r \
    --event close_write \
    --event moved_to \
    --format '%w%f' \
    "${valid_dirs[@]}" 2>>"$LOG_FILE" | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    sleep 2
    "$HOME/.local/bin/davinci-decode-fix" "$path" || true
done
